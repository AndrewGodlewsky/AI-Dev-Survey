# Real survey exports are named personal data and this repository is public.
# Only the fake-persona sample is committed.
scoring/*.csv
!scoring/scored-sample.csv

# Real Forms exports, wherever they land. Real data lives ONLY in data/ (#27);
# the two exceptions are committed artifacts that contain no real data.
data/
*.xlsx
!scoring/scoring.xlsx
!app/sample-export.xlsx

# Python bytecode (the app runs from source)
__pycache__/
